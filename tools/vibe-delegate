import glob, hashlib, json, os, sys

sess = sys.argv[1]
changed = {p.strip() for p in os.environ.get("CHANGED_LIST", "").split()
           if p.strip() and "__pycache__" not in p and not p.endswith(".pyc")}
seen, attempts = set(), []

def rel(path):
    path = path or ""
    return os.path.relpath(path) if os.path.isabs(path) else path

# A --resume'd session's journal also holds the earlier runs' writes, whose files
# are untouched in THIS run: they read as MISMATCH and failed the run. Journal
# entries carry createdAt (ms epoch) — keep only those from this run onward.
try:
    T0_MS = (os.path.getmtime(os.environ["RUN_SENTINEL"]) - 5) * 1000
except (KeyError, OSError):
    T0_MS = 0

def walk(o, ts=None):
    if isinstance(o, dict):
        if isinstance(o.get("createdAt"), (int, float)):
            ts = o["createdAt"]
        tn = o.get("toolName") or ""
        inp = o.get("input")
        if ts is not None and ts < T0_MS:
            pass  # written by an earlier run of this session
        elif isinstance(inp, dict) and (tn.endswith("search_replace") or tn.endswith("write_file")):
            c = inp.get("content")
            body = json.dumps(c, sort_keys=True) if not isinstance(c, str) else c
            # search_replace journals the target as file_path, write_file as path.
            target = inp.get("file_path") or inp.get("path")
            key = (tn, target, hashlib.sha1(body.encode()).hexdigest())
            if key not in seen:
                seen.add(key)
                size = len(c) if isinstance(c, str) else sum(len(e.get("new_str", "")) for e in (c or []) if isinstance(e, dict))
                attempts.append((tn.split(".")[-1], rel(target), size))
        for v in o.values():
            walk(v, ts)
    elif isinstance(o, list):
        for v in o:
            walk(v, ts)

for f in sorted(glob.glob(sess + "/journal/*.jsonl")):
    for line in open(f, errors="replace"):
