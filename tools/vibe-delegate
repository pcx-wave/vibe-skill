    _reason = 'narrated_no_tools' if _tok_out > 0 else 'silent_exit'
elif _tok_out < 50 and _fc == 0 and _tc < 3 and _agent not in _readonly_agents:
    _reason = 'near_empty'
elif _fc == 0 and _exit == 0 and _agent not in _readonly_agents:
    # No `_tc >= 3` floor (removed 2026-09-30): a write-capable run that changed
    # no file is never "ok", whether it made 1 tool call or 8. With the floor, a
    # 1-2 call run with prose output fell through to 'ok'.
    _reason = 'wrote_nothing'
elif os.environ.get('DELEGATE_AUDIT_MISMATCH') and _agent not in _readonly_agents:
    # A write the journal recorded never reached disk (see WRITE AUDIT above).
    _reason = 'write_mismatch'
elif stats.get('turn_cap_hit') and not _vo and _agent not in _readonly_agents:
    # Legacy heuristic, only when there is no Vibe 3 export to say 'finished'.
    # Files changed, but Vibe ran out of turns before its final answer: the
    # task is likely PARTIAL. Before this check such runs were logged as 'ok'.
    _reason = 'turn_cap'
elif entry.get('warn_count', 0) > 0:
    _reason = 'warn_only'
else:
    _reason = 'ok'

entry['failure_reason'] = _reason
# wrote_nothing kept for backwards compat with older delegate-report versions
entry['wrote_nothing'] = _reason in ('wrote_nothing', 'silent_exit', 'near_empty')

with open(LOG, 'a') as f:
    f.write(json.dumps(entry) + '\n')

tok = entry.get('tokens_total', '?')
saved = entry['cost_claude_eq'] - entry.get('cost_usd', 0)
saved_str = f', saved ~${saved:.4f} vs Claude' if saved > 0 else ''
adapt_str = f'  [{",".join(adaptations)}]' if adaptations else ''
