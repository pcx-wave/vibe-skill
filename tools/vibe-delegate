        except OSError:
            _sent_m = None
    if _sent_m is not None and _os.path.isdir('.vibe-recovery'):
        for _rn in sorted(_os.listdir('.vibe-recovery')):
            _rp = _os.path.join('.vibe-recovery', _rn)
            try:
                if _os.path.isfile(_rp) and _os.path.getmtime(_rp) > _sent_m:
                    _recs.append(_rn)
            except OSError:
                pass
    if _recs:
        _report.append(f'RECOVER: {len(_recs)} payload(s) in .vibe-recovery/: '
                       + ', '.join(_recs[:3]))
    else:
        _report.append('RECOVER: none')
except Exception:
    pass

# NEXT: what the caller should do with this run.
try:
    if _reason in _limit_reasons and _sid_rep:
        _report.append(f'NEXT: vibe-delegate {_os.getcwd()} "continue" '
                       f'{_os.environ.get("DELEGATE_MAX_TURNS", "")} --resume {_sid_rep}')
    elif _contras:
        _report.append('NEXT: resolve the CONTRADICTION line(s) before accepting the run')
    elif _verdict in ('OK', 'READ-ONLY'):
        _report.append('NEXT: none')
    else:
        _report.append('NEXT: fix the cause named in RESULT; do not relaunch verbatim')
except Exception:
    pass

entry['report_files_undeclared'] = _undeclared
entry['report_files_missing'] = _missing
entry['verify_status'] = _verify_status
entry['vibe_report_present'] = _vibe_report_present
entry['contradictions'] = _contras

with open(LOG, 'a') as f:
    f.write(json.dumps(entry) + '\n')

tok = entry.get('tokens_total', '?')
saved = entry['cost_claude_eq'] - entry.get('cost_usd', 0)
saved_str = f', saved ~${saved:.4f} vs Claude' if saved > 0 else ''
adapt_str = f'  [{",".join(adaptations)}]' if adaptations else ''
reason_str = f'  {_reason}' if _reason != 'ok' else ''
print(f'[log] → {LOG}  ({tok} tokens, exit {_exit}, {duration}s{saved_str}{reason_str}{adapt_str})')

# Ground-truth report: the last block before the RESULT verdict line.
print('')
print('=== DELEGATION REPORT ===')
for _rline in _report:
    print(_rline)

# Loud, last-line verdict. failure_reason used to be a single word at the end of
# the [log] line, with exit code 0 — easy to read past. Callers (and Claude) must
# treat FAILED as "nothing usable landed", whatever stdout narrated.
_FAIL_HINTS = {
    'wrote_nothing':     'Vibe read/explored but never wrote (turn cap hit? large file? see WRITE AUDIT)',
    'silent_exit':       'Vibe never engaged (0 tokens, 0 tool calls)',
    'near_empty':        'Vibe produced almost nothing',
    'narrated_no_tools': 'Vibe described the change instead of calling a write tool',
    'denied':            'a tool call was auto-denied (path outside workdir?)',
    'write_mismatch':    'a write Vibe journaled did NOT land on disk (see WRITE AUDIT)',
    'syntax_error':      'files written but syntax check failed',
    'sr_fail':           'search_replace did not match (anchor/UTF-8?)',
    'exit_error':        'vibe exited non-zero',
    'turn_cap':          'out of turns (auto-continue rounds included) — task PARTIAL; split it, or resume (below)',
    'timeout':           'time budget used up before Vibe finished — task PARTIAL',
    'budget_limit':      'token/price/length limit hit — task PARTIAL',
    'refusal':           'the model refused the task',
    'infra_error':       'the model API failed mid-run, even after one automatic resume',
    'usage_error':       'Vibe or the model API rejected the request itself (bad agent name, flag, model setting) — fix it, do NOT retry verbatim',
    'verify_fail':       'files landed but the VERIFY command failed — the task is not done',
}
_sid = stats.get('session_id') or ''
_verr = stats.get('vibe_error') or ''
if _reason in _FAIL_HINTS:
    if _reason in ('turn_cap', 'timeout', 'budget_limit', 'infra_error') and _fc > 0:
        # A limit stop does not mean nothing landed: a write in flight when the
        # limit hit can still be on disk (see the late-write rescan above).
        # Seen 2026-11-10: FAILED [timeout] printed with files_changed=1, and the
        # supervisor concluded "nothing was done" without reading the diff.
        print(f'=== RESULT: PARTIAL [{_reason}] — {_fc} file(s) DID land on disk despite the limit. Read the DIFF / git status below BEFORE relaunching anything. ===')
    else:
        print(f'=== RESULT: FAILED [{_reason}] — {_FAIL_HINTS[_reason]}. Do NOT report success; inspect git diff. ===')
    if _verr:
        print(f'    vibe error: {_verr}')
    if _sid and _reason in ('turn_cap', 'timeout', 'budget_limit', 'infra_error'):
        print(f'    resume this session (keeps its context — for the rest of THIS task, never a fresh session): vibe-delegate <workdir> "continue" <turns> --resume {_sid}')
elif _agent in _readonly_agents:
    print('=== RESULT: READ-ONLY run (no writes expected) ===')
else:
    if _reason == 'ok_resumed_nothing_left':
        print('=== RESULT: OK — resumed session finished with nothing left to write (earlier run did the work); read its final answer ===')
    elif os.environ.get('DELEGATE_HAD_SESSION') == '1':
        print(f'=== RESULT: OK — {_fc} file(s) changed, verified against the session journal ===')
    else:
        print(f'=== RESULT: OK (UNVERIFIED) — {_fc} file(s) changed on disk, but no session journal was found to cross-check. Read git diff. ===')
try:
    with open(os.environ['DELEGATE_REASON_FILE'], 'w') as _rf:
        _rf.write(_reason)
except (KeyError, OSError):
    pass
PYLOG

# Exit 3 = vibe itself exited 0 but produced nothing usable (see RESULT line).
# Keeps `vibe-delegate ... && next-step` chains from sailing past a failed run.
FINAL_REASON=$(cat "$DELEGATE_REASON_FILE" 2>/dev/null)
case "$FINAL_REASON" in
  wrote_nothing|silent_exit|near_empty|narrated_no_tools|denied|write_mismatch|syntax_error|sr_fail|turn_cap|timeout|budget_limit|refusal|infra_error|usage_error|verify_fail)
    if [ "$VIBE_EXIT" -eq 0 ]; then exit 3; fi ;;
esac
exit $VIBE_EXIT
}
