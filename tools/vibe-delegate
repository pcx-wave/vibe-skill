    for tool, path, size in attempts:
        state = "on disk: CHANGED" if path in changed else "on disk: UNCHANGED  <-- MISMATCH"
        mismatch = mismatch or path not in changed
        print(f"  {tool:<14} {path}  (+{size} chars)  {state}")
    tracked = {p for _, p, _ in attempts}
for p in sorted(changed - tracked):
    # Unified harness: writes made from inside run_typescript or bash are not
    # file_system.* actions, so they only show up here.
    print(f"  [WARN] {p} changed on disk but no journaled write (edited via bash/run_typescript?)")
sf = os.environ.get("DELEGATE_STATS_FILE", "")
if sf and calls:
    try:
        st = json.load(open(sf))
        st["sr_unrecovered"] = unrecovered
        json.dump(st, open(sf, "w"))
    except (OSError, ValueError):
