    for a in (rt.get("actions") or [])[_skip:]:
        call = (a.get("request") or {}).get("call") or {}
        name = call.get("name") or ""
        if not (name.endswith("search_replace") or name.endswith("write_file")):
            continue
        args = call.get("arguments") or {}
        err = (((a.get("result") or {}).get("result") or {}).get("error") or {}).get("message", "")
        calls.append((name.split(".")[-1], rel(args.get("file_path") or args.get("path")),
                      a.get("state") == "succeeded", err))
