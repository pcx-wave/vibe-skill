#!/usr/bin/env bash
{ # Whole script in one group: bash parses it all before running, so editing or
  # redeploying this file while a delegation runs cannot corrupt that run (seen
  # 2026-11-09: 4 benchmark runs died with 'syntax error near done').
# vibe-delegate — Launch Vibe programmatically and capture the result
# Usage: vibe-delegate <workdir> <prompt> [max-turns] [agent] [timeout-secs]
#
# ROOT CAUSE FIX (2026-05-10):
#   vibe checks for a TTY on startup. Without one (e.g. when piped directly),
#   it hangs indefinitely waiting for terminal initialisation → 0 tool calls,
#   silent timeout. Fix: wrap vibe in `script -q -c "..." /dev/null` to allocate
#   a pseudo-TTY. The JSON streaming output is then piped cleanly to the parser.
#
# TTY ALLOCATION (2026-05-23):
#   Superseded the `script` wrapper above with python3 pty.spawn — more portable
#   (no GNU/BSD flag differences) and works even without a parent controlling TTY.
#   See the SCRIPT_CMD definition below for the current implementation.
#
# PROMPT SAFETY (2026-05-12):
#   Long prompts with Python code, dicts, colons, emojis, or accented chars are
#   passed via a temp file (read by vibe via --prompt-file if supported, else via
#   a wrapper that cats the file). This avoids shell injection / truncation bugs.
#
# RUN LOG (2026-05-12):
#   Appends one JSONL entry to ~/.local/share/delegate-runs.jsonl after each run.
#   Fields: ts, delegate, project, prompt_words, agent, max_turns, timeout_secs,
#           exit_code, timed_out, tool_calls, files_changed, syntax_errors,
#           duration_secs, tokens_in, tokens_out, tokens_total, cost_usd, model,
#           warn_count, search_replace_fails, cost_claude_eq, wrote_nothing,
#           failure_reason, adaptations.

# Pull out --require "<string>" flags (repeatable) from anywhere in the args,
# then treat the rest as positional. Each required string must already exist in
# the workdir or the run is aborted before launch (see pre-flight gate below).
REQUIRES=()
INCLUDES=()
POSITIONAL=()
VERBOSE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --require)
      # `shift 2` fails (and shifts nothing) when --require is the last arg, which
      # re-enters this loop forever: a dangling --require hung the caller.
      if [ $# -lt 2 ]; then echo "ERROR: --require needs a string argument" >&2; exit 2; fi
      REQUIRES+=("$2"); shift 2 ;;
    --verbose) VERBOSE=1; shift ;;
    --resume)
      # Continue an earlier Vibe session (its id is printed on every partial run).
      if [ $# -lt 2 ]; then echo "ERROR: --resume needs a session id" >&2; exit 2; fi
      RESUME_SESSION="$2"; RESUME_MODE="explicit"; shift 2 ;;
    --resume-last)
      # Reuse the most recent vibe session recorded for this workdir in the run
      # log (resolved below). For continuation tasks only — the caller decides;
      # never auto-resume unconditionally, a stale unrelated context pollutes runs.
      RESUME_LAST=1; shift ;;
    --no-resume) NO_RESUME=1; shift ;;
    --include)
      # --include path:A-B — inject the verbatim lines A-B of path (inside the
      # workdir) into the prompt as a REFERENCE block, so Vibe does not need to
      # grep/read that region. Repeatable. Capped at DELEGATE_INCLUDE_MAX_BYTES.
      if [ $# -lt 2 ]; then echo "ERROR: --include needs path:A-B" >&2; exit 2; fi
      INCLUDES+=("$2"); shift 2 ;;
    --continue-rounds)
      if [ $# -lt 2 ]; then echo "ERROR: --continue-rounds needs a number" >&2; exit 2; fi
      CONTINUE_ROUNDS="$2"; shift 2 ;;
    --no-continue) CONTINUE_ROUNDS=0; shift ;;
    --allow-code) ALLOW_CODE=1; shift ;;
    --force) FORCE=1; shift ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done
set -- "${POSITIONAL[@]}"

WORKDIR="${1:?Usage: vibe-delegate <workdir> <prompt> [max-turns] [agent] [timeout-secs] [--require STR ...] [--include path:A-B ...] [--resume SID | --resume-last | --no-resume] [--force]}"
PROMPT="${2:?Prompt required}"
MAX_TURNS="${3:-10}"
AGENT="${4:-}"
TIMEOUT_SECS="${5:-300}"

# Hard ceiling: SKILL.md has documented "never exceed 12 turns, decompose instead"
# since 2026-05, but nothing enforced it — one observed session (2026-06-17) ran
# a 4-file refactor at max-turns=12 that still only got 2/4 files done for 334k tokens.
# Decomposition was the documented fix; this makes it impossible to skip by accident.
if [ "$MAX_TURNS" -gt 12 ] 2>/dev/null; then
  echo "WARNING: max-turns $MAX_TURNS exceeds the hard cap of 12 — clamping to 12. Decompose the task into sequential runs instead of raising this." >&2
  MAX_TURNS=12
fi

case "$MAX_TURNS" in ''|*[!0-9]*) echo "ERROR: max-turns '$MAX_TURNS' is not a number" >&2; exit 2 ;; esac
case "$TIMEOUT_SECS" in ''|*[!0-9]*) echo "ERROR: timeout-secs '$TIMEOUT_SECS' is not a number" >&2; exit 2 ;; esac
# Turn-budget honesty (2026-11-10): a thinking-model call costs ~60-90s wall
# clock, so a time budget smaller than max-turns x ~80s means the deadline hits
# before the turn cap — the model is told a budget it cannot spend and stops
# mid-task (observed: 12 turns / 480s -> only ~6 ran). Clamp max-turns to what the
# budget allows so the RUN BUDGET line tells the truth and the model writes
# earlier. Override the per-turn cost with DELEGATE_TURN_SECS_PER_TURN.
TURN_SECS="${DELEGATE_TURN_SECS_PER_TURN:-80}"
AFFORDABLE=$(( TIMEOUT_SECS / TURN_SECS ))
if [ "$AFFORDABLE" -ge 1 ] && [ "$MAX_TURNS" -gt "$AFFORDABLE" ]; then
  echo "WARNING: max-turns $MAX_TURNS clamped to $AFFORDABLE (timeout ${TIMEOUT_SECS}s / ~${TURN_SECS}s per model call). Raise timeout-secs or accept fewer turns." >&2
  MAX_TURNS=$AFFORDABLE
fi
CONTINUE_ROUNDS="${CONTINUE_ROUNDS:-2}"
case "$CONTINUE_ROUNDS" in ''|*[!0-9]*) echo "ERROR: --continue-rounds '$CONTINUE_ROUNDS' is not a number" >&2; exit 2 ;; esac
RESUME_SESSION="${RESUME_SESSION:-}"
RESUME_MODE="${RESUME_MODE:-}"
AUTO_RESUME=0
# ── Resume resolution ────────────────────────────────────────────────────────
# Priority: explicit --resume <sid> > --resume-last > auto-detect > fresh session.
# Auto-detect (default; off with --no-resume or DELEGATE_AUTO_RESUME=0): reuse the
# most recent vibe session of this workdir when the previous run was cut by a
# limit (unfinished task = continuation by definition); session still on disk,
# last run < DELEGATE_AUTO_RESUME_MAX_AGE_H (default 24h) old, resume chain <
# DELEGATE_MAX_RESUME_CHAIN (default 3). Lexical prompt-similarity auto-resume was
# tried and REMOVED (2026-11-10): thresholds uncalibrated, never fired in prod —
# --resume-last covers same-feature continuation, decided by the caller.
# The model cannot pick its own session (the id is fixed at launch), so the check
# lives in the launcher — the only place it can. Decision printed to stderr.
if [ -z "$RESUME_SESSION" ] && [ "${NO_RESUME:-0}" != 1 ] && [ "${DELEGATE_AUTO_RESUME:-1}" != "0" ]; then
  RL=$(DELEGATE_RUN_LOG="${DELEGATE_RUN_LOG:-$HOME/.local/share/delegate-runs.jsonl}" \
       RESOLVE_WD="$WORKDIR" RESOLVE_MODE="${RESUME_LAST:+last}" \
       python3 - <<'PYRES'
import json, os, sys
from datetime import datetime, timezone
log = os.environ['DELEGATE_RUN_LOG']
wd = os.path.realpath(os.environ['RESOLVE_WD'])
mode = os.environ.get('RESOLVE_MODE') or 'auto'   # 'auto' | 'last' (empty env = auto)
max_age_h = float(os.environ.get('DELEGATE_AUTO_RESUME_MAX_AGE_H', '24'))
max_chain = int(os.environ.get('DELEGATE_MAX_RESUME_CHAIN', '3'))
vh = os.environ.get('VIBE_HOME') or os.path.join(os.path.expanduser('~'), '.vibe')
LIMIT_STOP = {'turn_cap', 'timeout', 'budget_limit', 'infra_error'}
try:
    lines = open(log, errors='replace').read().splitlines()
except OSError:
    sys.exit(0)
now = datetime.now(timezone.utc)
# Resume-chain cap: count consecutive most-recent same-workdir runs that resumed
# a session (walking back until one did not). Past DELEGATE_MAX_RESUME_CHAIN
# (default 3) auto-resume is refused — a long chain bloats the context and anchors
# the model on stale decisions. Explicit --resume / --resume-last bypass the cap.
chain = 0
for line in reversed(lines):
    line = line.strip()
    if not line:
        continue
    try:
        r0 = json.loads(line)
    except ValueError:
        continue
    if r0.get('delegate') != 'vibe' or os.path.realpath(r0.get('workdir') or '/') != wd:
        continue
    if r0.get('resumed_session'):
        chain += 1
    else:
        break
for line in reversed(lines):
    line = line.strip()
    if not line:
        continue
    try:
        r = json.loads(line)
    except ValueError:
        continue
    if r.get('delegate') != 'vibe' or os.path.realpath(r.get('workdir') or '/') != wd:
        continue
    sid = r.get('session_id') or ''
    if not sid:
        continue
    if not os.path.isfile(os.path.join(vh, 'logs', 'session', 'unified', sid, 'meta.json')):
        continue
    ts = r.get('ts', '')
    age_h = 999.0
    try:
        age_h = (now - datetime.fromisoformat(ts.replace('Z', '+00:00'))).total_seconds() / 3600
    except Exception:
        pass
    if mode == 'auto' and age_h > max_age_h:
        continue
    if mode == 'auto' and chain >= max_chain:
        sys.stderr.write(f"[auto-resume] rejected {sid} (resume chain {chain} >= {max_chain}) — fresh session\n")
        sys.exit(0)
    reason = r.get('failure_reason', '')
    if mode == 'last' or reason in LIMIT_STOP:
        print(f"{sid}|{ts}|{reason}")
        sys.exit(0)
    sys.stderr.write(f"[auto-resume] rejected {sid} (age {age_h:.1f}h, reason {reason or 'ok'}) — fresh session\n")
    sys.exit(0)
PYRES
)
  if [ -n "$RL" ]; then
    RESUME_SESSION="${RL%%|*}"
    _rest="${RL#*|}"; RL_TS="${_rest%%|*}"; RL_REASON="${_rest#*|}"
    if [ "${RESUME_LAST:-0}" = 1 ]; then
      RESUME_MODE="last"
      echo "[resume-last] reusing session $RESUME_SESSION (last vibe run for $WORKDIR: $RL_TS, reason ${RL_REASON:-ok})" >&2
    else
      AUTO_RESUME=1; RESUME_MODE="auto"
      echo "[auto-resume] reusing session $RESUME_SESSION (last run $RL_TS was limit-stopped: ${RL_REASON:-ok}) — pass --no-resume for a fresh session" >&2
    fi
  elif [ "${RESUME_LAST:-0}" = 1 ]; then
    echo "[resume-last] no previous vibe session found for $WORKDIR — starting fresh" >&2
  fi
fi

# Agent mapping (2026-11-09). Vibe 3.0 (installed 2026-10-29) has only four primary
# agents: ask | accept-edits | smart-approve | auto-approve. `plan`, `default`,
# `lean` were removed, and ~/.vibe/agents/*.toml are subagents: passing any of
# them dies at once with "Agent 'plan' not found" (exit 2). Read-only names now
# map to auto-approve with the write tools disabled (verified: writes refused).
READONLY=0
VIBE_AGENT_FLAG=""
case "$AGENT" in
  plan|explore|readonly|planner|architect|code-reviewer|code-architect|code-explorer)
    READONLY=1; VIBE_AGENT_FLAG="auto-approve" ;;
  ""|default|lean|auto-approve) VIBE_AGENT_FLAG="auto-approve" ;;
  *) VIBE_AGENT_FLAG="$AGENT" ;;
esac

# Time budget (2026-11-09). TIMEOUT_SECS is the TOTAL wall-clock budget of the
# whole delegation, auto-continue rounds included: it is never raised. Measured
# on the 19 successful Vibe 3 runs: p50 95 s, max 386 s; 300 s covers 17/19.
# The 3 timeouts were not slowness (one long single-call file generation, two
# re-read loops), so a bigger budget would only have made them fail later.
if [ "$TIMEOUT_SECS" -lt 60 ]; then
  echo "ERROR: timeout-secs must be >= 60 (got $TIMEOUT_SECS)" >&2; exit 2
fi
RUN_START=$(date +%s)
ROUND_LIMIT=$TIMEOUT_SECS

if [ ! -d "$WORKDIR" ]; then
  echo "ERROR: workdir '$WORKDIR' does not exist" >&2
  exit 1
fi

# Pre-flight gate: a search_replace can't match an anchor that isn't in the file,
# so abort before wasting a vibe run if any --require string is absent. Turns the
# "grep the target first" rule into an enforced check; logs a cheap precheck_abort.
if [ "${#REQUIRES[@]}" -gt 0 ]; then
  MISSING=()
  for s in "${REQUIRES[@]}"; do
    # Scope to source: git grep (tracked + untracked, honours .gitignore) in a repo,
    # else recursive grep excluding .git/node_modules. A bare `grep -r` also hit
    # .git packfiles and vendored dirs, so a stale anchor could false-pass.
    if git -C "$WORKDIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git -C "$WORKDIR" grep -qF --untracked -e "$s" 2>/dev/null || MISSING+=("$s")
    else
      grep -rqF --exclude-dir=.git --exclude-dir=node_modules -e "$s" "$WORKDIR" 2>/dev/null || MISSING+=("$s")
    fi
  done
  if [ "${#MISSING[@]}" -gt 0 ]; then
    echo "=== PRECHECK ABORT — required string(s) not found in $WORKDIR ==="
    for s in "${MISSING[@]}"; do echo "  missing: $s"; done
    echo "Nothing was launched. Fix the anchor (grep locally) or the workdir, then retry."
    python3 - "$WORKDIR" <<'PYABORT'
import json, os, sys
from pathlib import Path
from datetime import datetime, timezone
wd = sys.argv[1]
LOG = Path(os.environ.get('DELEGATE_RUN_LOG') or Path.home() / '.local' / 'share' / 'delegate-runs.jsonl')
LOG.parent.mkdir(parents=True, exist_ok=True)
entry = {
    'ts': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'delegate': 'vibe', 'workdir': wd, 'project': os.path.basename(wd.rstrip('/')),
    'exit_code': 2, 'tool_calls': 0, 'files_changed': 0, 'tokens_total': 0,
    'duration_secs': 0, 'failure_reason': 'precheck_abort',
}
with open(LOG, 'a') as f:
    f.write(json.dumps(entry) + '\n')
PYABORT
    exit 2
  fi
fi

# Model override: /vibe-model-pick writes alias to this flag file.
# VIBE_ACTIVE_MODEL is inherited by the script child process via `script`.
VIBE_MODEL_FLAG="$HOME/.local/share/vibe-model.flag"
VIBE_MODEL_OVERRIDE=""
# DELEGATE_MODEL (env) wins over the flag file: lets a caller or a benchmark pin a
# model alias for one run without touching the user's /vibe-model-pick choice.
if [ -n "${DELEGATE_MODEL:-}" ]; then
  VIBE_MODEL_OVERRIDE="$DELEGATE_MODEL"
  export VIBE_ACTIVE_MODEL="$VIBE_MODEL_OVERRIDE"
elif [ -f "$VIBE_MODEL_FLAG" ]; then
  VIBE_MODEL_OVERRIDE=$(tr -d '[:space:]' < "$VIBE_MODEL_FLAG")
  export VIBE_ACTIVE_MODEL="$VIBE_MODEL_OVERRIDE"
fi
export DELEGATE_VERBOSE="$VERBOSE"

cd "$WORKDIR"
START_NS=$(date +%s%N)
PROMPT_WORDS=$(printf '%s' "$PROMPT" | wc -w | tr -d ' ')
GIT_BEFORE=$(git rev-parse HEAD 2>/dev/null || echo "no-git")

# Big-file guard (2026-09-30). Vibe's read_file caps at ~50 KiB and returns the
# file TRUNCATED; on a large target it then burns its whole turn budget on
# grep/sed exploration and writes nothing (app/__init__.py, 2 of 3 runs). Any
# existing file named in the prompt above 40 KB gets a standing instruction so
# this no longer depends on the caller remembering it.
# Pre-written code guard (2026-11-10). In 36 of 169 real delegations (21 %) Claude
# had already written the code or final text, in the prompt (9) or in a staging
# file the prompt told Vibe to apply "exactly" (28, ~4,800 chars each): Claude
# paid for writing it (output tokens) and then for the delegation. If the code
# is written, applying it directly is cheaper. --allow-code overrides.
PREWRITTEN=$(PROMPT_TEXT="$PROMPT" WD="$WORKDIR" python3 - << 'PYCODE'
import os, re, subprocess, time
p = os.environ["PROMPT_TEXT"]; wd = os.environ["WD"]
code_re = re.compile(r'^\s*(def |class |async def |function |const |let |var |import |from \S+ import |export |return |@\w|<[a-zA-Z][^>]*>|[\w.\[\]"\']+\s*=\s*\S)')
code = sum(1 for ln in p.split("\n") if code_re.match(ln))
staged = []
if re.search(r"verbatim|exactly|character for character|apply (its|the|all)|copy (it|the)", p, re.I):
    for name in set(re.findall(r"[\w./-]+\.(?:txt|md|py|js|ts|json|html|patch|diff)", p)):
        f = os.path.join(wd, name)
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_size > 1500 and time.time() - st.st_mtime < 3600:
            staged.append(f"{name}({st.st_size // 1024}KB)")
print(f"{code}|{' '.join(staged)}")
PYCODE
)
PREWRITTEN_CODE_LINES=${PREWRITTEN%%|*}
PREWRITTEN_STAGED=${PREWRITTEN#*|}
if [ "${PREWRITTEN_CODE_LINES:-0}" -ge 10 ] && [ "${ALLOW_CODE:-0}" != 1 ]; then
  echo "=== PRECHECK ABORT — the prompt already contains ${PREWRITTEN_CODE_LINES} lines of written code ==="
  echo "If the code is written, apply it yourself: delegating it pays for it twice."
  echo "Otherwise describe the goal, the files and the check, and let Vibe write the code."
  echo "(Override: --allow-code.) Nothing was launched."
  exit 2
fi
if [ -n "$PREWRITTEN_STAGED" ]; then
  echo "[PREFLIGHT] WARNING: the prompt asks Vibe to apply recently written file(s) exactly: $PREWRITTEN_STAGED. If you wrote that content, applying it yourself is cheaper than delegating." >&2
fi

# ── Launch preflight (2026-11-11): blocking refusals ────────────────────────
# The read-burn failures came from prompts naming too many reference files or
# saying "read X first"; headerless prompts and fresh runs over recent sessions
# burn the budget the same way. Every rule below refuses BEFORE vibe is
# launched (exit 2) — nothing is spent. --force bypasses all of them and the
# bypassed rule names are logged as preflight_forced in the run entry (PYLOG).
VIOLATION_NAMES=()
VIOLATION_MSGS=()
pf_add() { VIOLATION_NAMES+=("$1"); VIOLATION_MSGS+=("$2"); }
# Rule 1: TASK/MODIFY/VERIFY headers — a prompt without them delegates nothing.
# Skipped on a resumed session: its task is already in the history, and the
# printed resume hint is a bare "continue" prompt.
if [ -z "${RESUME_SESSION:-}" ]; then
  printf '%s' "$PROMPT" | grep -q 'TASK:'   || pf_add missing_task_header "missing TASK: header — the prompt must state one imperative"
  printf '%s' "$PROMPT" | grep -q 'VERIFY:' || pf_add missing_verify_header "missing VERIFY: header — the prompt must name the check command"
  if [ "$READONLY" != 1 ]; then
    printf '%s' "$PROMPT" | grep -q 'MODIFY:' || pf_add missing_modify_header "missing MODIFY: header — list the files to change (read-only agents may omit it)"
  fi
fi
# Files to modify are not reads: a mechanical change across 10 files is one run.
MODIFY_FILES=$(printf '%s\n' "$PROMPT" | grep -E 'MODIFY:' | head -1 | sed 's/.*MODIFY:[[:space:]]*//' | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]].*//' | grep .)
# Ground truth for the PYLOG delegation report: declared files + the VERIFY line,
# captured before any harness text is appended to the prompt below.
export DELEGATE_MODIFY_FILES="$MODIFY_FILES"
DELEGATE_VERIFY_LINE=$(printf '%s\n' "$PROMPT" | grep 'VERIFY:' | head -1 | sed 's/.*VERIFY:[[:space:]]*//' || true)
export DELEGATE_VERIFY_LINE
PROMPT_FILES=$(printf '%s' "$PROMPT" | grep -oE '[A-Za-z0-9_./-]+\.(py|js|ts|jsx|tsx|html|json|md|sh|css|ya?ml|toml|txt|csv)' | sort -u | grep -vxF -f <(printf '%s\n' "${MODIFY_FILES:-/dev/null/none}"))
N_FILES=$(printf '%s\n' "$PROMPT_FILES" | grep -c .)
# Rule 2: > 4 named files — extra reads burn the time budget.
if [ "$N_FILES" -gt 4 ]; then
  pf_add too_many_files "prompt names $N_FILES files (rule: <= 4) — pass the needed regions with --include path:A-B instead"
  echo "[PREFLIGHT] files: $(printf '%s' "$PROMPT_FILES" | tr '\n' ' ')" >&2
fi
# Rule 3: "read ... first" — say what to extract instead of a blanket read.
if printf '%s' "$PROMPT" | grep -qiE 'read [a-z0-9_./-]+ first|read (the )?(file|reference)s? first'; then
  pf_add read_first "prompt says 'read ... first' — say what to extract (grep -n anchors), or use --include path:A-B"
fi
# Rule 4: more than one not-yet-existing MODIFY file with a short budget —
# scaffolding blank files is slow; more than one does not fit under 480 s.
MODIFY_LINE=$(printf '%s\n' "$PROMPT" | grep -E 'MODIFY:' | head -1 | sed 's/.*MODIFY:[[:space:]]*//')
if [ -n "$MODIFY_LINE" ]; then
  UNBORN=0; UNBORN_LIST=""
  IFS=',' read -r -a _mfiles <<< "$MODIFY_LINE"
  for _f in "${_mfiles[@]}"; do
    _f="${_f#"${_f%%[![:space:]]*}"}"; _f="${_f%%[[:space:]]*}"
    case "$_f" in ''|none|-|n/a) continue ;; esac
    if [ ! -f "$_f" ] && [ ! -f "$WORKDIR/$_f" ]; then
      UNBORN=$((UNBORN+1)); UNBORN_LIST="$UNBORN_LIST $_f"
    fi
  done
  if [ "$UNBORN" -gt 1 ] && [ "$TIMEOUT_SECS" -lt 480 ]; then
    pf_add unborn_files_short_timeout "MODIFY lists $UNBORN file(s) not on disk yet ($UNBORN_LIST) with timeout-secs ${TIMEOUT_SECS}s — creating more than one new file needs >= 480"
  fi
fi
# Rule 5: a vibe run for this workdir finished < 2 h ago and no resume choice
# was made — the caller must pick --resume-last (continue) or --no-resume.
if [ -z "${RESUME_SESSION:-}" ] && [ "${RESUME_LAST:-0}" != 1 ] && [ "${NO_RESUME:-0}" != 1 ]; then
  RECENT_RUN=$(DELEGATE_RUN_LOG="${DELEGATE_RUN_LOG:-$HOME/.local/share/delegate-runs.jsonl}" PREFLIGHT_WD="$WORKDIR" python3 - <<'PYRECENT'
import json, os, sys
from datetime import datetime, timezone
try:
    lines = open(os.environ['DELEGATE_RUN_LOG'], errors='replace').read().splitlines()
except OSError:
    sys.exit(0)
wd = os.path.realpath(os.environ['PREFLIGHT_WD'])
now = datetime.now(timezone.utc)
for line in reversed(lines):        # most recent matching run decides
    line = line.strip()
    if not line:
        continue
    try:
        r = json.loads(line)
    except ValueError:
        continue
    if r.get('delegate') != 'vibe' or os.path.realpath(r.get('workdir') or '/') != wd:
        continue
    try:
        age_h = (now - datetime.fromisoformat(r.get('ts', '').replace('Z', '+00:00'))).total_seconds() / 3600
    except Exception:
        continue
    if age_h < 2:
        print('yes')
    sys.exit(0)
PYRECENT
)
  if [ "$RECENT_RUN" = "yes" ]; then
    pf_add recent_run_no_resume_flag "a vibe run for this workdir finished < 2 h ago — pass --resume-last (continue) or --no-resume (fresh)"
  fi
fi
if [ "${#VIOLATION_NAMES[@]}" -gt 0 ]; then
  if [ "${FORCE:-0}" = 1 ]; then
    DELEGATE_PREFLIGHT_FORCED="$(IFS=,; echo "${VIOLATION_NAMES[*]}")"
    export DELEGATE_PREFLIGHT_FORCED
    echo "[PREFLIGHT] --force: bypassing ${#VIOLATION_NAMES[@]} rule(s) [$DELEGATE_PREFLIGHT_FORCED] — launching anyway" >&2
  else
    echo "=== PREFLIGHT REFUSAL — nothing was launched ===" >&2
    for _i in "${!VIOLATION_MSGS[@]}"; do echo "  - ${VIOLATION_MSGS[$_i]}" >&2; done
    echo "Required prompt format:" >&2
    echo "  TASK: <one imperative>" >&2
    echo "  MODIFY: a.py, b.py   (read-only agents may omit MODIFY)" >&2
    echo "  VERIFY: <command>" >&2
    echo "(Fix the prompt, or pass --force to bypass all refusals.)" >&2
    exit 2
  fi
fi

BIG_LIST=""
for _f in $(printf '%s' "$PROMPT" | grep -oE '[A-Za-z0-9_./-]+\.(py|js|html|json|md|sh|css|ya?ml|toml|txt)' | sort -u); do
  if [ -f "$_f" ] && [ "$(stat -c %s "$_f" 2>/dev/null || echo 0)" -gt 40000 ]; then
    BIG_LIST="$BIG_LIST $_f($(( $(stat -c %s "$_f") / 1024 ))KB)"
  fi
done
if [ -n "$BIG_LIST" ]; then
  echo "[PREFLIGHT] large file(s) over one read_file window (50 KiB):$BIG_LIST — injecting grep/offset instruction" >&2
  # Measured 2026-10-01 (docs/harness-audit-2026-10-01.md H8): read_file returns
  # the first 51,200 bytes with was_truncated=true; offset/limit page the rest.
  # Vibe's system prompt forbids editing an unread file, so point it at a
  # targeted read instead of forbidding reads.
  PROMPT="$PROMPT

HARNESS NOTE: these files are larger than one read_file window (50 KiB):$BIG_LIST. Do not read them from the top. Find the line with grep -n, read only that region with read_file offset/limit, then change it with the edit tool using the exact text you just read."
fi
# The model is never told its --max-turns budget (H10); without it a capped run
# just stops mid-task with exit 0 (H2). Name the edit tool by its model-facing
# name: asking for "search_replace" made Vibe spend turns on search_tool_functions (H4).
PROMPT="$PROMPT

RUN BUDGET: $MAX_TURNS turns total; one model call can cost 60-90s, so a time limit can hit after a few turns. WRITE EARLY: first file write within your first 3 turns. Read smart: grep -n the 2-4 anchors you need, read only the matched region, batch ALL independent reads in ONE call, never re-read a file, verify with grep. In-place changes: use the edit tool (batch many edits in one turn via tools.file_system.edit from run_typescript). Keep your last turn for a short summary. Partial writes count: what is on disk when the run is cut stays there.

CHECKS: run only quick, targeted checks (one test file, one import, one script), each well under 60 s. Never run a full build, a whole-project type-check or the whole test suite: the caller verifies afterwards, and a long command can eat the run's whole time budget.

GIT: do not commit, push, stash, reset or switch branches. Leave every change uncommitted in the working tree: the caller reviews the diff and commits.

END REPORT: end your final message with exactly these five lines, a few words each, 'none' when empty:
DONE: <what is finished>
NOT DONE: <what is left>
ASSUMED: <guesses you made>
BLOCKED: <what stopped you>
CHECK: <what the caller should check>"
if [ "$READONLY" = 1 ]; then
  PROMPT="$PROMPT

READ-ONLY RUN: do not modify, create or delete any file (file write tools are disabled; do not use bash to write either). Report your findings as your final answer."
fi
# Injected whenever the run continues an existing session (explicit --resume,
# --resume-last, or auto-resume): the previous task is in the history, its files
# are on disk — re-reading or redoing it is what burns the budget (2026-11-10:
# a fresh session re-read the target file 5 times, 244k tokens, 0 files, turn_cap).
if [ -n "$RESUME_SESSION" ]; then
  PROMPT="$PROMPT

RESUMED SESSION: you are continuing an existing session for this workdir — the previous task is in this history and its files are on disk. Do NOT re-read files you already read in this session, and do NOT redo completed work; if unsure what is already done, run git status --short and git diff --stat first. The new task below builds on that state."
fi
# --include path:A-B: inject verbatim line regions into the prompt as REFERENCE
# blocks, so Vibe uses them directly instead of grepping/reading those files.
if [ "${#INCLUDES[@]}" -gt 0 ]; then
  INCLUDE_BLOCK=$(INCLUDES_NL="$(printf '%s\n' "${INCLUDES[@]}")" WD="$WORKDIR" python3 - <<'PYINC'
import os, sys
wd = os.path.realpath(os.environ['WD'])
max_bytes = int(os.environ.get('DELEGATE_INCLUDE_MAX_BYTES', '8000'))
out, total = [], 0
for item in os.environ['INCLUDES_NL'].splitlines():
    item = item.strip()
    if not item:
        continue
    path, _, rng = item.rpartition(':')
    try:
        a_s, _, b_s = rng.partition('-')
        a, b = int(a_s), int(b_s or a_s)
    except ValueError:
        sys.stderr.write(f"[include] bad range, skipped: {item}\n"); continue
    ap = os.path.realpath(os.path.join(wd, path))
    if not ap.startswith(wd + os.sep) or not os.path.isfile(ap):
        sys.stderr.write(f"[include] not a file inside workdir, skipped: {item}\n"); continue
    lines = open(ap, errors='replace').read().splitlines()
    a = max(1, min(a, len(lines))); b = max(a, min(b, len(lines)))
    chunk = '\n'.join(lines[a-1:b])
    if total + len(chunk) > max_bytes:
        chunk = chunk[:max(0, max_bytes - total)] + "\n... [truncated at DELEGATE_INCLUDE_MAX_BYTES]"
    total += len(chunk)
    out.append(f"REFERENCE {path}:{a}-{b} (verbatim — use directly, do NOT re-read or grep this region):\n```\n{chunk}\n```")
print('\n\n'.join(out))
PYINC
)
  if [ -n "$INCLUDE_BLOCK" ]; then
    PROMPT="$PROMPT

$INCLUDE_BLOCK"
  fi
fi
AUDIT_RC=0

# Sentinel file for mtime-based change detection. `git diff --name-only` is binary
# (modified-vs-not), so it misses a re-edit to a file that was ALREADY dirty before
# this run started — exactly what happens with sequential same-file delegations,
# which RC-2 itself recommends as the mitigation for parallel edits. It also reports
# nothing at all in a non-git workdir. mtime-since-sentinel catches every real write
# regardless of prior git state.
SENTINEL=$(mktemp /tmp/vibe-sentinel-XXXXXX)

echo "=== VIBE START ==="
echo "Workdir : $WORKDIR"
echo "Agent   : ${AGENT:-auto-approve}$([ "$READONLY" = 1 ] && echo " (read-only: auto-approve, write tools disabled)")"
[ -n "$RESUME_SESSION" ] && echo "Resume  : $RESUME_SESSION"
echo "Model   : ${VIBE_MODEL_OVERRIDE:-(config default)}"
echo "Turns   : $MAX_TURNS"
echo "Timeout : ${TIMEOUT_SECS}s total (all rounds)"
echo "Prompt  : ${PROMPT:0:120}..."
echo "==================="

# Write prompt to a temp file — avoids shell injection when prompt contains
# colons, quotes, emojis, accented chars, or multi-line Python/JS code.
PROMPT_FILE=$(mktemp /tmp/vibe-prompt-XXXXXX.txt)
printf '%s' "$PROMPT" > "$PROMPT_FILE"

# Write the vibe command to a temp script.
# Reads the prompt from the file to stay safe from shell expansion.
VIBE_SCRIPT=$(mktemp /tmp/vibe-cmd-XXXXXX.sh)

# Stats handoff file: Python parser writes JSON here; bash reads it for the log.
DELEGATE_STATS_FILE=$(mktemp /tmp/delegate-stats-XXXXXX.json)
printf '{}' > "$DELEGATE_STATS_FILE"
export DELEGATE_STATS_FILE

# Final failure_reason handoff (PYLOG -> bash) so the script can exit non-zero.
DELEGATE_REASON_FILE=$(mktemp /tmp/delegate-reason-XXXXXX.txt)
export DELEGATE_REASON_FILE

# Per-run dir: one --output-dir per round. Vibe 3 writes export.json there on
# EVERY exit (outcome, stop_reason, session_id, usage): the ground truth that
# replaces guessing the session from mtimes.
RUN_DIR=$(mktemp -d /tmp/vibe-run-XXXXXX)

trap 'rm -rf "$VIBE_SCRIPT" "$PROMPT_FILE" "$DELEGATE_STATS_FILE" "$DELEGATE_REASON_FILE" "$SENTINEL" "$RUN_DIR"' EXIT

# write_vibe_script <prompt-file> <resume-session-id or ""> <output-dir>
write_vibe_script() {
  local _resume=""
  [ -n "$2" ] && _resume="--resume $(printf '%q' "$2")"
  local _ro=""
  # Tool names verified on Vibe 3.0.3 (2026-11-09): disabling these refuses writes.
  [ "$READONLY" = 1 ] && _ro="--disabled-tools write_file --disabled-tools search_replace --disabled-tools edit"
  {
    echo '#!/usr/bin/env bash'
    echo "PROMPT_CONTENT=$(printf '%q' "$(cat "$1")")"
    # --time-limit: Vibe stops itself cleanly (exit 3, outcome deadline) and still
    # writes the export. The outer `timeout` only SIGTERMs the pty wrapper, never
    # Vibe, so a killed run left no export, no tokens, no diagnosis (verified).
    # The obsolete --legacy-harness/--experimental-harness flags are gone in Vibe 3.
    printf 'exec vibe --agent %q %s %s -p "$PROMPT_CONTENT" --trust --max-turns %q --time-limit %q --output-dir %q --output streaming --workdir %q\n' \
      "$VIBE_AGENT_FLAG" "$_resume" "$_ro" "$MAX_TURNS" "$ROUND_LIMIT" "$3" "$WORKDIR"
  } > "$VIBE_SCRIPT"
  chmod +x "$VIBE_SCRIPT"
}

# Pseudo-TTY for vibe via python pty.spawn (works without a parent TTY, unlike `script`).
SCRIPT_CMD=(python3 -c 'import pty,sys,os; sys.exit(os.waitstatus_to_exitcode(pty.spawn(sys.argv[1:])))' "$VIBE_SCRIPT")

run_round() {
# Outer backstop only: Vibe's own --time-limit (ROUND_LIMIT) fires first.
BACKSTOP_SECS=$(( ROUND_LIMIT + 60 ))
timeout -k 15 "$BACKSTOP_SECS" "${SCRIPT_CMD[@]}" | python3 -c "
import sys, json, re, os

ANSI_RE = re.compile(r'\x1b\[[0-9;]*[mABCDEFGHJKSTfhilmnprsu]|\x1b\([AB]|\x0f|\x0e')
# Everything unprintable except tab / newline / CR.
CTRL_RE = re.compile(r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]')
tools_called = 0
warn_count = 0
sr_fails = 0
sandbox_blocked = False
denied_count = 0
writes = []
def clean(line):
    line = line.replace('\r', '')
    return ANSI_RE.sub('', line).strip()

def safe(s):
    # clean() only strips escapes from the RAW stdin line. An ESC written as
    # an escaped-unicode literal (backslash-u-001b) inside a JSON string value
    # arrives here escape-free, so clean() sees nothing to strip; json.loads
    # then decodes it back into a real ESC, which reaches stdout when printed.
    # A tool name, path or denial reason can therefore repaint the terminal
    # (erase-line, cursor-up) and forge output. That matters twice over: this
    # text is read by a terminal AND fed back to the orchestrating model.
    # So strip at every print of a decoded value, not just on the raw line.
    return CTRL_RE.sub('', ANSI_RE.sub('', str(s)))

def as_text(content):
    # Vibe emits message content EITHER as a plain string (session-log /
    # legacy schema) OR as a list of content blocks (current --output
    # streaming schema: [{'type': 'text', 'text': ...}]). Calling .lower()
    # straight on the list crashed the whole parser and threw away the run
    # output, so normalise to str once, here, before anything touches it.
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for blk in content:
            if isinstance(blk, dict):
                parts.append(blk.get('text') or blk.get('content') or '')
            elif isinstance(blk, str):
                parts.append(blk)
        return chr(10).join(p for p in parts if p)
    if content is None:
        return ''
    return str(content)

for raw in sys.stdin:
    line = clean(raw)
    if not line:
        continue
    try:
        msg = json.loads(line)
    except json.JSONDecodeError:
        # vibe reports startup failures as PLAIN TEXT on stdout, not JSON —
        # e.g. 'Error: Agent X not found' or 'Agent X is a subagent and cannot
        # be used as the primary agent'. Silently swallowing every non-JSON
        # line meant those surfaced only as exit 1 after 1.5s with no reason.
        low = line.lower()
        if low.startswith('error') or 'not found' in low or 'cannot be used' in low or 'usage:' in low:
            warn_count += 1
            print(f'  [ERROR] {safe(line)[:200]}', flush=True)
        continue

    role    = msg.get('role', '')
    content = as_text(msg.get('content', ''))
    etype   = msg.get('type', '')

    if role in ('system', 'user'):
        continue

    if 'not permitted' in content.lower():
        sandbox_blocked = True

    # ── streaming schema: tool calls arrive as 'effect', not role='tool' ──
    # Without this the run reports 'Tool calls: 0' even when the agent read
    # and wrote files, which then mislabels a fine run as WROTE_NOTHING.
    if etype == 'effect':
        detail = msg.get('detail') or {}
        tool_name = safe(detail.get('toolName') or msg.get('title') or '')
        kind = detail.get('kind') or ''
        tinput = detail.get('input') or {}
        # read_file / write_file carry the target as 'path' (H7).
        filepath = safe(tinput.get('filePath') or tinput.get('file_path') or tinput.get('path') or '')
        state = msg.get('state') or {}
        status = state.get('status') or ''
        disp = state.get('display') or {}
        tools_called += 1
        _why = safe(disp.get('message') or state.get('reason') or '')
        if status in ('cancelled', 'skipped') and 'interrupt' in _why.lower():
            # The run stopping (--time-limit deadline, turn end) interrupts the
            # running tool: that is not an approval refusal.
            print(f'  [STOPPED] {tool_name} {filepath} - {_why} (run ended mid-call)', flush=True)
        elif status in ('cancelled', 'skipped'):
            # A denied approval lands here. Silent in the old parser: the run
            # exited 0 having done nothing, with no hint why.
            # 'skipped' matters too: project_effect_state tests event.cancelled
            # first and event.skipped second, so a denial carrying a custom
            # decision.feedback — and every pre-tool hook denial — arrives as
            # SkippedEffectState and was being printed as a plain [WARN].
            denied_count += 1
            sandbox_blocked = True
            reason = safe(disp.get('message') or state.get('reason') or 'denied')
            print(f'  [DENIED] {tool_name} {filepath} - {reason}', flush=True)
        elif kind in ('file_write', 'file_edit') or 'write' in tool_name.lower() or 'edit' in tool_name.lower():
            if filepath:
                writes.append(filepath)
            if 'search_replace' in tool_name.lower():
                ok = disp.get('success', True)
                if not ok:
                    sr_fails += 1
                sr_status = 'OK' if ok else 'FAIL'
                print(f'  [tool]  search_replace [{sr_status}] {filepath}', flush=True)
            else:
                print(f'  [tool]  file: {filepath or tool_name}', flush=True)
        elif kind == 'file_read' or 'read' in tool_name.lower():
            print(f'  [read]  {filepath or tool_name}', flush=True)
        else:
            summary = safe(disp.get('message') or (detail.get('display') or {}).get('summary') or '')
            print(f'  [tool]  {tool_name}: {summary[:100]}', flush=True)
        if disp.get('success') is False and status not in ('cancelled', 'skipped'):
            warn_count += 1
            # Print it — a counted-but-invisible warn is useless. The common
            # one is 'Output (N KiB) exceeds maximum allowed size (50.0 KiB)',
            # which means the agent silently saw only PART of the file.
            failmsg = safe(disp.get('message') or state.get('reason') or '')
            if failmsg:
                print(f'  [WARN]  {tool_name}: {failmsg[:160]}', flush=True)
        continue

    # Approval prompts that need a human: also invisible before.
    if etype == 'callback' and (msg.get('detail') or {}).get('kind') == 'approval':
        perms = (msg.get('detail') or {}).get('requiredPermissions') or []
        labels = ', '.join(safe(p.get('label', '')) for p in perms if isinstance(p, dict))
        cb_title = safe(msg.get('title', '') or '')
        print(f'  [APPROVAL] {cb_title} {labels}', flush=True)
        continue

    if etype == 'reasoning':
        continue

    if role == 'assistant':
        # Escapes stripped, text kept — legitimate output must survive intact.
        text = safe(content).strip()
        if not text:
            continue
        print(f'  [vibe] {text[:400]}', flush=True)

    elif role == 'tool':
        tools_called += 1
        first_line = safe(content.split('\n')[0]) if content else ''
        tool_name  = safe(msg.get('tool', '') or msg.get('name', ''))

        # Detect writes to track files for syntax check
        if 'write' in tool_name.lower() or 'edit' in tool_name.lower():
            filepath = safe(msg.get('path') or msg.get('file_path') or '')
            if filepath:
                writes.append(filepath)
            print(f'  [tool]  file: {filepath or first_line[:80]}', flush=True)
        elif first_line.startswith('path:'):
            print(f'  [read]  {first_line[5:].strip()}', flush=True)
        elif 'search_replace' in tool_name.lower() or 'SEARCH' in content:
            status = 'FAIL' if 'failed' in content.lower() else 'OK'
            if status == 'FAIL':
                sr_fails += 1
            print(f'  [tool]  search_replace [{status}] {first_line[:80]}', flush=True)
        elif first_line.startswith('error') or 'Error' in first_line or 'failed' in first_line.lower():
            warn_count += 1
            print(f'  [WARN]  {first_line[:120]}', flush=True)
        elif 'matches:' in first_line or 'grep' in tool_name.lower():
            print(f'  [tool]  matches: {first_line[:100]}', flush=True)
        elif 'command' in tool_name.lower():
            print(f'  [tool]  command: {first_line[:100]}', flush=True)
        else:
            snippet = safe(first_line or content)[:100]
            print(f'  [tool]  {snippet}', flush=True)

_denied_note = f'  |  DENIED: {denied_count}' if denied_count else ''
print(f'Tool calls: {tools_called}  |  warns: {warn_count}  |  sr_fails: {sr_fails}{_denied_note}')
if denied_count:
    print('  ^ tool calls were DENIED (approval refused). Common cause: a path')
    print('    outside the workdir — --trust does not cover those. Move the file')
    print('    inside the workdir and re-run.')

# Write partial stats so the token block can merge into it.
_sf = os.environ.get('DELEGATE_STATS_FILE', '')
if _sf:
    # Accumulate across auto-continue rounds instead of overwriting.
    try:
        prev = json.load(open(_sf))
    except Exception:
        prev = {}
    try:
        with open(_sf, 'w') as _f:
            json.dump({'tool_calls': prev.get('tool_calls', 0) + tools_called,
                       'warn_count': prev.get('warn_count', 0) + warn_count,
                       'search_replace_fails': prev.get('search_replace_fails', 0) + sr_fails,
                       'sandbox_blocked': bool(prev.get('sandbox_blocked')) or sandbox_blocked,
                       'denied_count': prev.get('denied_count', 0) + denied_count}, _f)
    except Exception:
        pass
"
return "${PIPESTATUS[0]}"
}

# read_export <dir> → prints "outcome|session_id|steps|error message" ("" if no export).
# A 4xx from the model API (except 429 rate limit) is a request the provider will
# refuse again (e.g. "reasoning_effort 'none' is not supported for this model"):
# resuming it only burns another round. Seen 2026-11-09, 8/8 runs.
is_permanent_api_error() {
  printf '%s' "$1" | grep -qE 'Status 4[0-9][0-9]' && ! printf '%s' "$1" | grep -q 'Status 429'
}

read_export() {
  python3 - "$1/export.json" << 'PYEXP'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    print(''); sys.exit(0)
err = ((d.get('error') or {}).get('message') or '').replace('|', '/').replace('\n', ' ')
print(f"{d.get('outcome') or ''}|{d.get('session_id') or ''}|{d.get('steps') or 0}|{err[:200]}")
PYEXP
}

# ── Rounds: run, then auto-continue the SAME session when Vibe stopped on its
# turn limit (or a transient API failure). Measured 2026-11-09: since the Vibe 3
# upgrade, 7 of 12 failed runs were exit 3 = turn_limit (12 model calls of 12),
# previously logged as a crash. A resumed session keeps its context, so it does
# not re-read anything: verified, a turn-limited run resumed with
# `--resume <id> -p continue` finished the task (5/5 files) in 3 more calls.
# A resumed session's runtime-state already lists the earlier run's actions; the
# WRITE AUDIT must skip them, or their files (untouched in THIS run) would show
# as MISMATCH and fail the run.
AUDIT_SKIP_SEQ=0
if [ -n "$RESUME_SESSION" ]; then
  AUDIT_SKIP_SEQ=$(python3 - "${VIBE_HOME:-$HOME/.vibe}/logs/session/unified/$RESUME_SESSION" << 'PYSKIP'
import glob, json, sys
last = 0
for f in glob.glob(sys.argv[1] + "/journal/*.jsonl"):
    for line in open(f, errors="replace"):
        try:
            last = max(last, int(json.loads(line).get("sequence") or 0))
        except (ValueError, AttributeError, TypeError):
            pass
print(last)
PYSKIP
)
fi
export AUDIT_SKIP_SEQ

ROUND=0
CONTINUED=0
INFRA_RETRIED=0
CUR_PROMPT_FILE="$PROMPT_FILE"
CUR_SID="$RESUME_SESSION"
OUTCOMES=""
while :; do
  OUT_DIR="$RUN_DIR/round-$ROUND"
  write_vibe_script "$CUR_PROMPT_FILE" "$CUR_SID" "$OUT_DIR"
  run_round
  VIBE_EXIT=$?
  IFS='|' read -r R_OUTCOME R_SID R_STEPS R_ERR <<< "$(read_export "$OUT_DIR")"
  [ -n "$R_SID" ] && CUR_SID="$R_SID"
  OUTCOMES="$OUTCOMES ${R_OUTCOME:-noexport(exit $VIBE_EXIT)}"
  [ -n "$R_ERR" ] && echo "  [VIBE ERROR] $R_ERR"
  NEXT=""
  if [ "$R_OUTCOME" = "turn_limit" ] && [ "$CONTINUED" -lt "$CONTINUE_ROUNDS" ] && [ -n "$CUR_SID" ]; then
    # CONTINUED is only incremented once the round is actually launched (below):
    # incrementing here logged auto_continued=1 on runs where the budget check
    # then broke the loop and no continuation round ever ran (seen 2026-11-10).
    NEXT="turn limit reached — continuing the same session ($((CONTINUED + 1))/$CONTINUE_ROUNDS)"
  elif [ "$R_OUTCOME" = "infrastructure_failure" ] && [ "${R_STEPS:-0}" -gt 0 ] && ! is_permanent_api_error "$R_ERR" && [ "$INFRA_RETRIED" -eq 0 ] && [ -n "$CUR_SID" ]; then
    # steps > 0: the agent did run, so this is the model API failing mid-run
    # (e.g. IncompleteProviderStream), not a bad flag/agent (those have 0 steps).
    INFRA_RETRIED=1; NEXT="model API failed mid-run — resuming the same session once"
  fi
  if [ -z "$NEXT" ] && [ "$AUTO_RESUME" = 1 ] && [ "$ROUND" -eq 0 ] \
     && { [ "$R_OUTCOME" = "usage_error" ] || [ "$R_OUTCOME" = "config_error" ]; } \
     && [ "${R_STEPS:-0}" -eq 0 ] && [ -n "$CUR_SID" ]; then
    # The auto-resumed session was rejected by vibe itself (stale/corrupt):
    # fall back to one fresh session instead of dying with usage_error.
    echo "  [auto-resume] session $CUR_SID rejected (${R_OUTCOME}, 0 steps) — starting a fresh session once"
    CUR_SID=""; AUTO_RESUME=0; AUDIT_SKIP_SEQ=0; export AUDIT_SKIP_SEQ
    NEXT="auto-resumed session unusable — fresh session"
  fi
  [ -z "$NEXT" ] && break
  # Continuation rounds only get what is left of the single total budget.
  ROUND_LIMIT=$(( TIMEOUT_SECS - ($(date +%s) - RUN_START) ))
  if [ "$ROUND_LIMIT" -lt 60 ]; then
    echo ""
    echo "=== NO AUTO-CONTINUE: total time budget (${TIMEOUT_SECS}s) spent ==="
    break
  fi
  CONTINUED=$((CONTINUED + 1))
  ROUND=$((ROUND + 1))
  echo ""
  echo "=== AUTO-CONTINUE: $NEXT ==="
  CUR_PROMPT_FILE="$RUN_DIR/continue-prompt.txt"
  printf '%s' "You stopped before finishing (turn limit or a model API error). Continue the ORIGINAL task exactly where you stopped. Do not redo or re-read work that is already done; check the files you already changed only if you need to. RUN BUDGET: $MAX_TURNS more turns. Keep your last turn for a short final summary of everything you changed across the whole task." > "$CUR_PROMPT_FILE"
done
FINAL_OUTCOME="$R_OUTCOME"
FINAL_SID="$CUR_SID"

# Late-write rescan (2026-11-10). A limit stop (deadline / turn_limit) interrupts
# the model mid-turn and the pty wrapper's `timeout -k 15` lets the child finish
# its in-flight tool call briefly AFTER the stream EOF the parser saw — so a
# write_file can land on disk a few seconds after this loop ends, i.e. after the
# verdict's find -newer would have run. Settle, then let the CHANGED scan below
# (which runs after the token blocks) see it. Without this, the run is reported
# "0 file(s) changed" while the file exists on disk (observed: write journaled
